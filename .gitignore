.cursor

# OS
**/.DS_Store

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.ipynb_checkpoints/

# Raw MRI data (huge, pulled from the HPC / challenge data drop, never committed).
# Generated artifacts that other roles depend on (code/src/data/splits/split_v1.json,
# code/src/data/config.yaml) are intentionally NOT covered by this rule and must stay tracked.
code/src/data/mri_gz/

# Local-only trimmed split file used for individual sanity checks -- never commit,
# the real split_v1.json above stays tracked and frozen.
code/src/data/splits/split_local_test.json

# Model checkpoints / experiment outputs (large, role-generated)
**/checkpoints/
**/checkpoints_local_test/
**/*.pt
**/*.pth

# Training history figures/logs (saved inside checkpoint dirs above, but
# listed explicitly in case a run ever writes them elsewhere)
**/*_history.json
**/*_history.png*.zip
